{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Deployment configuration comes from environment variables, using the "__" separator.
  // Nothing below is committed; these are the variables the deployment must supply.
  //
  //   ConnectionStrings__Postgres   Npgsql key=value string, NOT a postgresql:// URI —
  //                                 Npgsql cannot parse the URI form. On Railway, compose it
  //                                 from the addon's parts in the variable editor:
  //                                 Host=${{Postgres.PGHOST}};Port=${{Postgres.PGPORT}};
  //                                 Database=${{Postgres.PGDATABASE}};
  //                                 Username=${{Postgres.PGUSER}};Password=${{Postgres.PGPASSWORD}}
  //   ASPNETCORE_ENVIRONMENT        Production
  //
  // ConnectionStrings and Cors deliberately live in appsettings.Development.json only, so the
  // "?? throw" guards in Program.cs actually fire on a misconfigured production deploy instead of
  // silently resolving a committed local placeholder.
  //
  // AllowedHosts must keep "healthcheck.railway.app" in the list if it is ever tightened from "*"
  // — Railway's deploy probe sends that Host header, and a 400 means the deploy never goes live.
  "AllowedHosts": "*"
}
