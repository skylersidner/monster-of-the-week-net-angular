<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Security pins, not direct dependencies. Both arrive transitively through the API's
      Microsoft.AspNetCore.DataProtection.EntityFrameworkCore 10.0.0. The API itself gets them
      from the ASP.NET Core shared framework, so NuGet prunes them there. This project uses the
      plain SDK, so it restores the vulnerable 10.0.0 packages instead. These are the lowest
      patched versions: 10.0.7 clears GHSA-9mv3-2cwr-p262, and 10.0.10 clears all eight
      System.Security.Cryptography.Xml advisories. Remove once the API's reference is 10.0.10 or later.
    -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.7" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MonsterOfTheWeek.Api\MonsterOfTheWeek.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>